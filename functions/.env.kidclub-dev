# Loaded by `firebase deploy --project=kidclub-dev` only. No secrets here —
# credentials live in Secret Manager. See src/externalGuard.ts.
#
# Easypay sandbox (api.test.easypay.pt). The dev secrets EASYPAY_ACCOUNT_ID /
# EASYPAY_API_KEY hold the sandbox account's keys since 2026-09-28.
EASYPAY_SANDBOX=true

# Gmail sender (keyless domain-wide delegation, see src/SendEmailFromOutbox.ts).
# Dev never actually sends: externalGuard blocks Gmail outside prod.
GMAIL_SENDER_SA=gmail-sender-kidclub-dev@kidclub-dev.iam.gserviceaccount.com

# Links in emails (APP_URL in src/kidclub/notifications.ts): the dev site, not kidclub.pt.
APP_URL=https://kidclub-dev-arcoiris.web.app
