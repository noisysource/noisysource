    "paths": {
      "@shared": ["../packages/shared/dist/index"],
      "@shared/*": ["../packages/shared/dist/*"]
    },
    "outDir": "lib",
    "rootDir": "src",
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}