{
  "compilerOptions": {
    // Root only, deliberately — "@shared/*" subpaths type-check fine here but
    // can never actually resolve at runtime (see packages/shared/package.json's
    // "//exports" note). Import from "@shared" root and this stays honest.
    "paths": {
      "@shared": ["../packages/shared/dist/index"]
    },
    "outDir": "lib",
    "rootDir": "src",
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}