{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm -w --filter @shared build",
      "pnpm -w --filter functions build"
    ]
  },
  "hosting": [
    {
      "target": "kidclub",
      "public": "apps/noisyphocus/kidclub/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/callable/backfillBillingSchedules",  "run": { "serviceId": "backfillbillingschedules",    "region": "europe-west3" } },
        { "source": "/callable/sendBillingNotice",         "run": { "serviceId": "sendbillingnotice",           "region": "europe-west3" } },
        { "source": "/callable/initiateMbwayPayment",      "run": { "serviceId": "initiatembwaypayment",        "region": "europe-west3" } },
        { "source": "/callable/initiateMultibancoPayment", "run": { "serviceId": "initiatemultibancopayment",   "region": "europe-west3" } },
        { "source": "/callable/initiateCardPayment",       "run": { "serviceId": "initiatecardpayment",         "region": "europe-west3" } },
        { "source": "/callable/setPaymentMethod",          "run": { "serviceId": "setpaymentmethod",            "region": "europe-west3" } },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "finances",
      "public": "apps/noisysource/finances/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
