.firebase/
apps/noisyphocus/kidclub/.env
functions/lib
apps/noisyphocus/kidclub/src/lib/featureFlags.ts

# macOS
.DS_Store

# Bank statements — contain real financial data, never commit
*.pdf
*.xlsx
*.xls

# App env files — project-specific, not committed
apps/noisysource/finances/.env.*
apps/noisysource/domotics/.env.*
# ...except domotics' dev build config, which CI needs to build the dev site
# (Renato, 2026-10-18). It's Firebase *web* config, public by design (it ships
# inside every bundle), with the same values as finances/.env.staging, which
# is tracked already. Never put a real secret in a .env.<mode> file: Vite
# bakes every VITE_* value into the public bundle.
!apps/noisysource/domotics/.env.staging
!apps/noisysource/domotics/.env.nsdev
!apps/noisysource/domotics/.env.nsprod

# Claude Code — personal/local-only config, never shared or committed
.claude/settings.local.json
.claude/worktrees/

# Real data: bank statements, payslips, FinHub seed and exports. Never commit.
prodata/
