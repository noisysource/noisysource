rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRainbowAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.rainbowAdmin == true;
    }

    function isFinhubAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.finhubAdmin == true;
    }

    function isOwner() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.owner == true;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Shared across all apps — stays at root level.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwner() || isRainbowAdmin() || isFinhubAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner();
    }

    // ── KidClub (Arco-Íris da Pequenada) ─────────────────────────────────────
    match /_apps/arcoiris {

      // Families: each family belongs to one primary user.
      match /families/{familyId} {
        allow read: if isAuthenticated() &&
          (resource.data.primaryContact.userId == request.auth.uid || isRainbowAdmin());
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() &&
          (resource.data.primaryContact.userId == request.auth.uid || isRainbowAdmin());
      }

      // Children: userId field stored for query-compatible rules.
      match /children/{childId} {
        allow read, write: if isRainbowAdmin();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        // Email-based access: admin-created children (ManualEnrollForm sets
        // familyId: '' and no userId until claimed) with a matching contactEmail.
        // Parent needs read (to pre-fill the claim form) and update (to link
        // familyId/userId) on first login — same pattern as
        // studyroom/transportationSubscriptions.
        allow read: if isAuthenticated() && resource.data.contactEmail == request.auth.token.email;
        allow update: if isAuthenticated()
          && resource.data.contactEmail == request.auth.token.email
          && (!('familyId' in resource.data) || resource.data.familyId == '')
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['userId', 'familyId', 'age', 'dateOfBirth', 'schoolName', 'schoolYear']);
      }

      // Study room subscriptions
      match /studyroom/{entryId} {
        allow read, write: if isRainbowAdmin();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        // Email-based access: admin-created subscriptions with a contactEmail but no familyId yet.
        // studyroom docs still use both `email` and `contactEmail` inconsistently, so check both.
        allow read: if isAuthenticated() &&
          (resource.data.contactEmail == request.auth.token.email || resource.data.email == request.auth.token.email);
        allow update: if isAuthenticated()
          && (resource.data.contactEmail == request.auth.token.email || resource.data.email == request.auth.token.email)
          && (!('familyId' in resource.data) || resource.data.familyId == '')
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['userId', 'familyId', 'childId', 'childAge', 'source']);
      }

      // Transportation subscriptions
      match /transportationSubscriptions/{subId} {
        allow read, write: if isRainbowAdmin();
        // Owner access by userId
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        // Email-based access: admin-created subscriptions with a contactEmail but no familyId yet.
        // Parent can read and fully claim (link family + child) on first login. No current
        // creation path sets familyId: '' here (checked: admin path omits it, parent paths
        // always set a real one) — accepting '' too anyway, for consistency with studyroom
        // and so this doesn't quietly break the same way if that ever changes.
        allow read: if isAuthenticated() && resource.data.contactEmail == request.auth.token.email;
        allow update: if isAuthenticated()
          && resource.data.contactEmail == request.auth.token.email
          && (!('familyId' in resource.data) || resource.data.familyId == '')
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['userId', 'familyId', 'childId', 'childAge', 'source']);
      }

      // Party bookings
      match /bookings/{bookingId} {
        allow read, write: if isRainbowAdmin();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      }

      // Billing records — created by Cloud Functions, read by clients and FinHub
      match /billing/{id} {
        allow read: if isRainbowAdmin() || isOwner() || isFinhubAdmin();
        allow write: if isRainbowAdmin() || isOwner();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Invoices (read-only for clients)
      match /invoices/{invoiceId} {
        allow read, write: if isRainbowAdmin() || isOwner();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Payments (read-only for clients)
      match /payments/{paymentId} {
        allow read, write: if isRainbowAdmin() || isOwner();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Config (read for all authenticated, write for admin)
      match /config/{configId} {
        allow read: if isAuthenticated();
        allow write: if isRainbowAdmin() || isOwner();
      }

      // App-level settings (read by functions via Admin SDK, write for admin)
      match /settings/{settingId} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Email outbox — written by functions, not directly by clients
      match /emailOutbox/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Email campaigns
      match /emailCampaigns/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Saved email templates (admin email composer)
      match /emailTemplates/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Events calendar
      match /events/{doc} {
        allow read: if isAuthenticated();
        allow write: if isRainbowAdmin();
      }

      // Immutable audit trail — full snapshot before each subscription change
      match /subscriptionVersions/{versionId} {
        allow read, write: if isRainbowAdmin();
        // Parents write a snapshot before every change they make; they cannot read back
        allow create: if isAuthenticated()
          && request.resource.data.changedBy.userId == request.auth.uid;
      }

      // Per-day/trip cancellations by clients
      match /eventModifications/{doc} {
        allow read: if isAuthenticated();
        allow write: if isRainbowAdmin();
        // Clients can create day-level cancellations for their own subscriptions (auto-approved)
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'approved'
          && request.resource.data.modificationType == 'cancelled'
          && (
            (request.resource.data.subscriptionType == 'study' &&
             get(/databases/$(database)/documents/_apps/arcoiris/studyroom/$(request.resource.data.subscriptionId)).data.userId == request.auth.uid)
            ||
            (request.resource.data.subscriptionType == 'transport' &&
             get(/databases/$(database)/documents/_apps/arcoiris/transportationSubscriptions/$(request.resource.data.subscriptionId)).data.userId == request.auth.uid)
          );
        // Clients can delete their own cancellations (restore a day)
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Materialized subscription occurrences (one per date, generated for the whole
      // school year on subscription create). Read by the client calendar/subscription
      // pages and the admin billing page; every write goes through
      // setReservationEventStatus (parents and staff) or the generation triggers in
      // reservationEvents.ts, both Admin SDK and so bypass these rules entirely — no
      // direct client write path exists or is needed.
      // Reads are scoped to staff or the owning family — `isAuthenticated()`
      // alone let any logged-in parent read every other family's occurrences.
      // The family link lives at families/{id}.primaryContact.userId (the same
      // field the families rule above matches on); the cross-document get() is
      // the same idiom eventModifications uses.
      match /reservationEvents/{doc} {
        allow read: if isRainbowAdmin() || isOwner() ||
          (isAuthenticated()
            && 'familyId' in resource.data
            && resource.data.familyId != ''
            && get(/databases/$(database)/documents/_apps/arcoiris/families/$(resource.data.familyId))
                 .data.primaryContact.userId == request.auth.uid);
        allow write: if isRainbowAdmin();
      }

      // Financial events
      match /financialEvents/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Staff
      match /employees/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }
      match /employmentContracts/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }
      match /dailySchedules/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }
      match /timesheets/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Camp subscriptions (families signing up for a camp)
      match /campSubscriptions/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      }

      // Camp definitions (periods/configs created by admin)
      match /camps/{doc} {
        allow read: if isAuthenticated();
        allow write: if isRainbowAdmin() || isOwner();
      }

      // Transport planner versions (route snapshots saved by admin)
      match /transportRoutes/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
      }

      // Camp
      match /campBookings/{doc} {
        allow read, write: if isRainbowAdmin() || isOwner();
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      }
      match /campDays/{doc} {
        allow read: if isAuthenticated();
        allow write: if isRainbowAdmin() || isOwner();
      }
    }

    // ── Finances app ─────────────────────────────────────────────────────────
    match /finances_people/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }
    match /finances_companies/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }
    match /finances_entities/{entityId} {
      allow read, write: if isFinhubAdmin();

      match /{collection}/{docId} {
        allow read, write: if isFinhubAdmin();
      }
    }

    // Cross-entity event stream (finances_events root collection)
    match /finances_events/{eventId} {
      allow read, write: if isFinhubAdmin();
    }

    // ── Domotics app ──────────────────────────────────────────────────────────
    // The app has no Firebase Auth, so the client is unauthenticated here. It
    // only ever touches `customization` (room/device display names — harmless).
    //
    // `netatmo` holds the OAuth client secret + refresh token and must never be
    // client-readable: a Hosting-level gate (IAP/login) does not protect
    // Firestore, which is reachable directly at firestore.googleapis.com. Only
    // legrandGetStatus/legrandSetState read it, via the Admin SDK, which
    // bypasses rules entirely — so denying it here costs nothing.
    //
    // Rules are permissive-OR: a separate, more specific `if false` match on a
    // secret doc would NOT override this wildcard, so the restriction has to
    // live in the condition below.
    //
    // Allowlist, not denylist: `netatmo` and `tuya` hold vendor credentials and
    // are read only by Cloud Functions through the Admin SDK, which bypasses
    // rules. Naming the two *safe* docs means every future vendor secret is
    // denied by default instead of depending on someone remembering to add it.
    match /domotics_config/{docId} {
      allow read, write: if docId in ['customization', 'floorplan'];
      // The bridge additionally reads its own device list, which holds the Tuya
      // local keys. Added as a separate `allow` so the allowlist above is left
      // exactly as it is: rules are permissive-OR, so this grants the bridge one
      // more document and widens nothing for anyone else.
      allow read: if isBridge() && docId == 'tuya_devices';
    }

    // Relay between the house and the app when away from the LAN. At home the
    // app talks to the bridge directly over HTTP and none of this is touched;
    // these documents exist only because a bridge behind NAT cannot be reached
    // from outside.
    //
    // Unlike the rest of the domotics collections, these MUST require auth:
    // `domotics_commands` is a channel that turns heating on and off, and it is
    // reachable from the public internet. The email check is a deliberate
    // belt-and-braces alongside isOwner(), so a missing role document cannot
    // lock the owner out of their own house.
    function isDomoticsOwner() {
      return isAuthenticated() &&
        (isOwner() || request.auth.token.email == 'admin@kidclub.pt');
    }

    // The bridge on the Raspberry Pi. It signs in as an ordinary Firebase Auth
    // user rather than using a service account, because the org policy
    // `iam.disableServiceAccountKeyCreation` forbids the key — and because the
    // role that path needed (roles/datastore.user) would have given a device in
    // the hall cupboard read/write over every collection here, including the
    // finances bank data. Identified by email, matching isDomoticsOwner above.
    function isBridge() {
      return isAuthenticated() &&
        request.auth.token.email == 'domotics-bridge@kidclub.pt';
    }

    match /domotics_state/{docId} {
      allow read: if isDomoticsOwner();
      allow write: if isBridge();
    }

    match /domotics_commands/{docId} {
      allow read, create: if isDomoticsOwner();
      // The bridge lists the queue, deletes each command once executed, and
      // writes an `error` field back onto the ones that fail.
      allow read, update, delete: if isBridge();
    }

    // Administration of the bridge itself — status, logs, restart — travelling
    // the same outbound path as commands, because the Pi accepts no inbound
    // connection and is otherwise unreachable from outside the house.
    //
    // This is a remote-execution channel into a private home, so it is held to
    // the same rule as the heating: only the owner may ask, and the bridge
    // enforces a fixed allowlist of actions on top of this. Delete is granted
    // to the owner as well so a finished request can be cleared from the app.
    match /domotics_admin/{docId} {
      allow read, create, delete: if isDomoticsOwner();
      // The bridge reads requests and writes the answer back onto the document.
      allow read, update, delete: if isBridge();
    }

    // ── Vault (Finances app) ─────────────────────────────────────────────────
    match /vault_config/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }
    match /vault_entries/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }

    // ── Notifications (Finances app) ─────────────────────────────────────────
    match /finances_notifications/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }

    // ── Bank statements (Finances app) ───────────────────────────────────────
    match /finances_bank_transactions/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }
    match /finances_bank_imports/{docId} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }

    // Shared Ledger collections (Finances app, legacy root-level)
    match /expenses/{doc} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }
    match /incomes/{doc} {
      allow read, write: if isFinhubAdmin() || isOwner();
    }
    match /plannedInstances/{doc} {
      allow read: if isAuthenticated();
      allow write: if isFinhubAdmin() || isRainbowAdmin();
    }
  }
}
