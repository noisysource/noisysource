rules_version = '2';
// Rules for the NoisySource projects (noisysource-dev, noisysource-prod): the
// private tools' own Firestore: Domotics, and FinHub (the Strata app, at the
// end). KidClub's rules, and the old FinHub's, are the repo-root
// firestore.rules, in KidClub's projects.
//
// The Domotics block is the one from the root file, with one difference:
// there is no `users` collection here, so the owner is known by email alone
// (the root file also accepts a `roles.owner` flag on the user's document).
//
// Tests: see README.md in this folder.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Domotics app ──────────────────────────────────────────────────────────
    // The app has no Firebase Auth, so the client is unauthenticated here. It
    // only ever touches `customization` (room/device display names — harmless).
    //
    // `netatmo` holds the OAuth client secret + refresh token and must never be
    // client-readable: a Hosting-level gate (IAP/login) does not protect
    // Firestore, which is reachable directly at firestore.googleapis.com. Only
    // legrandGetStatus/legrandSetState read it, via the Admin SDK, which
    // bypasses rules entirely — so denying it here costs nothing.
    //
    // Rules are permissive-OR: a separate, more specific `if false` match on a
    // secret doc would NOT override this wildcard, so the restriction has to
    // live in the condition below.
    //
    // Allowlist, not denylist: `netatmo` and `tuya` hold vendor credentials and
    // are read only by Cloud Functions through the Admin SDK, which bypasses
    // rules. Naming the two *safe* docs means every future vendor secret is
    // denied by default instead of depending on someone remembering to add it.
    match /domotics_config/{docId} {
      allow read, write: if docId in ['customization', 'floorplan'];
      // The bridge additionally reads its own device list, which holds the Tuya
      // local keys. Added as a separate `allow` so the allowlist above is left
      // exactly as it is: rules are permissive-OR, so this grants the bridge one
      // more document and widens nothing for anyone else.
      allow read: if isBridge() && docId == 'tuya_devices';
      // Heating automation settings (domotics-bridge/src/automation.ts). Unlike
      // the display documents above, this one decides how the house is heated,
      // so only the owner may read or change it; the bridge reads it to act on.
      // The bridge clamps every value to hard limits anyway — the rule decides
      // who, the bridge decides how much.
      allow read, write: if (isDomoticsOwner() || isAtlas()) && docId == 'automation';
      allow read: if isBridge() && docId == 'automation';
      // E13 guard on/off (domotics-bridge/src/guard.ts): it switches the heat
      // pump off and on by itself, so it is held to the automation's rule.
      allow read, write: if (isDomoticsOwner() || isAtlas()) && docId == 'guard';
      allow read: if isBridge() && docId == 'guard';
      // One-off "warm by HH:MM" request (domotics-bridge/src/warmby.ts). Read
      // by the owner and the bridge; written only by the `domoticsWarmBy`
      // callable (Admin SDK), which checks every request, so no client writes.
      allow read: if (isDomoticsOwner() || isBridge() || isAtlas()) && docId == 'warm_by';
      // Electricity tariff for the Energia page (packages/shared/lib/energyBill.ts):
      // prices, potência, billing day. The owner's alone; the bridge records kWh
      // and never needs a price.
      allow read, write: if (isDomoticsOwner() || isAtlas()) && docId == 'tariff';
    }

    // Relay between the house and the app when away from the LAN. At home the
    // app talks to the bridge directly over HTTP and none of this is touched;
    // these documents exist only because a bridge behind NAT cannot be reached
    // from outside.
    //
    // Unlike the rest of the domotics collections, these MUST require auth:
    // `domotics_commands` is a channel that turns heating on and off, and it is
    // reachable from the public internet. The owner is known by email: this
    // project has no `users` collection to hold a role.
    //
    // The address must be verified. Email/password sign-in is on in these
    // projects (the bridge uses it), and there anyone can create an account
    // with any address that isn't taken; only a verified one proves who it is.
    // Google sign-in, which the app uses, always verifies.
    function isDomoticsOwner() {
      return isAuthenticated() &&
        request.auth.token.email == 'admin@noisysource.com' &&
        request.auth.token.email_verified == true;
    }

    // The bridge on the Raspberry Pi. It signs in as an ordinary Firebase Auth
    // user rather than using a service account, because the org policy
    // `iam.disableServiceAccountKeyCreation` forbids the key — and because the
    // role that path needed (roles/datastore.user) would have given a device in
    // the hall cupboard read/write over every collection here, including the
    // finances bank data. Identified by its verified email, like isDomoticsOwner above (its account is
    // created verified: domotics-bridge/deploy/create-bridge-user.sh).
    function isBridge() {
      return isAuthenticated() &&
        request.auth.token.email == 'domotics-bridge@kidclub.pt' &&
        request.auth.token.email_verified == true;
    }

    // Atlas, Renato's assistant (repo noisysource/Atlas, on his Mac). It sees
    // and runs the house the way the app does, so below it gets what
    // isDomoticsOwner has, except bridge administration (domotics_admin). Three
    // things keep that safe: every change Atlas makes waits for Renato's OK on
    // a card in Atlas; the bridge clamps heating values to its own limits,
    // whoever asks; and the commands it may queue are held to the app's shapes
    // (isAtlasCommand). Its own Firebase Auth account, email and password like
    // the bridge's, created verified
    // (domotics-bridge/deploy/create-agent-user.sh). The vendor secrets
    // (netatmo, tuya, tuya_devices) stay out of its reach, as for every client.
    function isAtlas() {
      return isAuthenticated() &&
        request.auth.token.email == 'atlas@kidclub.pt' &&
        request.auth.token.email_verified == true;
    }

    // The commands Atlas may queue: the two the app sends for a thermostat
    // (target temperature, mode) and the heat pump's switch (domotics App.tsx,
    // handleThermostatCommand / handleHeatPumpCommand), in the app's document
    // shape (lib/bridge.ts, queueRelayCommand). Nothing else the bridge would
    // forward to a device.
    function isAtlasCommandEntry(c) {
      return c is map &&
        c.keys().hasOnly(['code', 'value']) &&
        c.keys().hasAll(['code', 'value']) &&
        c.code in ['temp_set', 'mode', 'switch'];
    }
    function isAtlasCommand(d) {
      return d.keys().hasOnly(['deviceId', 'commands', 'createdAt']) &&
        d.keys().hasAll(['deviceId', 'commands', 'createdAt']) &&
        d.deviceId is string &&
        d.commands is list &&
        d.commands.size() >= 1 && d.commands.size() <= 2 &&
        isAtlasCommandEntry(d.commands[0]) &&
        (d.commands.size() == 1 || isAtlasCommandEntry(d.commands[1])) &&
        d.createdAt == request.time;
    }

    match /domotics_state/{docId} {
      allow read: if isDomoticsOwner() || isAtlas();
      allow write: if isBridge();
    }

    // Heat pump faults and on/off transitions, recorded by the bridge
    // (domotics-bridge/src/incidents.ts) for the Reports page. A record of
    // what happened in the house: the owner reads it, only the bridge writes
    // it, and nobody deletes it from a client. The bridge writes each document
    // whole under a fixed id, so create + update is all it needs; it never reads
    // them back.
    match /domotics_incidents/{docId} {
      allow read: if isDomoticsOwner() || isAtlas();
      allow create, update: if isBridge();
    }

    // kWh history, recorded by the bridge (domotics-bridge/src/energy.ts) for
    // the Energia page: one document per Lisbon day, one field per 15-minute
    // slot. Like the incidents: the owner reads, only the bridge writes, nobody
    // deletes. The bridge patches one slot at a time, so create + update is all
    // it needs, and only under a date id; it never reads them back.
    match /domotics_energy/{docId} {
      allow read: if isDomoticsOwner() || isAtlas();
      allow create, update: if isBridge() && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Room and pump temperatures per 15-minute slot, and people's interventions
    // (domotics-bridge/src/climate.ts): how the house cools and warms up. Same
    // shape and same access as the energy history.
    match /domotics_climate/{docId} {
      allow read: if isDomoticsOwner() || isAtlas();
      allow create, update: if isBridge() && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    match /domotics_commands/{docId} {
      allow read, create: if isDomoticsOwner();
      // Atlas reads the queue like the owner, and creates only the app's own
      // thermostat and heat pump commands (isAtlasCommand above).
      allow read: if isAtlas();
      allow create: if isAtlas() && isAtlasCommand(request.resource.data);
      // The bridge lists the queue, deletes each command once executed, and
      // writes an `error` field back onto the ones that fail.
      allow read, update, delete: if isBridge();
    }

    // Administration of the bridge itself — status, logs, restart — travelling
    // the same outbound path as commands, because the Pi accepts no inbound
    // connection and is otherwise unreachable from outside the house.
    //
    // This is a remote-execution channel into a private home, so it is held to
    // the same rule as the heating: only the owner may ask (not Atlas), and the
    // bridge enforces a fixed allowlist of actions on top of this. Delete is granted
    // to the owner as well so a finished request can be cleared from the app.
    match /domotics_admin/{docId} {
      allow read, create, delete: if isDomoticsOwner();
      // The bridge reads requests and writes the answer back onto the document.
      allow read, update, delete: if isBridge();
    }

    // ── Tasks app (kanban) ────────────────────────────────────────────────────
    // apps/noisysource/tasks: one board per app plus "All systems". Renato's
    // alone from a client. The agents (Atlas, Claude Code through mcp/kanban)
    // never touch these collections directly: they go through the kanban*
    // callables (functions/src/tasks/callables.ts), which check every field and
    // can't delete. So no isAtlas() here, on purpose. `tasks_config` (the
    // board's GitHub token) has no match at all: closed to every client, the
    // owner included, and read by the functions (tasks/github.ts) only.
    match /tasks_boards/{boardId} {
      allow read, write: if isDomoticsOwner();
    }
    match /tasks_cards/{cardId} {
      allow read, write: if isDomoticsOwner();
      // History: added to, never edited; deleted with its card.
      match /activity/{entryId} {
        allow read, create, delete: if isDomoticsOwner();
      }
    }

    // Awakenings of Atlas on noisysource.com: who woke it, why, how they found
    // it, and the conversation. Written only by the atlasGate function (Admin
    // SDK; functions/src/website/atlasGate.ts). Renato and his Atlas read them
    // ("somebody's trying to reach you") and may mark one seen, nothing else.
    // atlas_gate/config (the Gemini key, the shared phrase, the panel token)
    // and atlas_gate_usage (the shared counter and the quiet hours) have no
    // rule: no client, Atlas included, can read or write them.
    match /atlas_awakenings/{id} {
      allow read: if isDomoticsOwner() || isAtlas();
      allow update: if (isDomoticsOwner() || isAtlas())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
    }

    // What Atlas may talk about, per role, and the personal keys: edited by
    // Renato (the maker panel on the site, through the function) and, later,
    // from his Atlas app. The function re-validates it on every read.
    match /atlas_gate/access {
      allow read, write: if isDomoticsOwner() || isAtlas();
    }

    // ── FinHub ───────────────────────────────────────────────────────────────
    // The Strata Treasury app (apps/noisysource/finhub, 2026-11-23). One shared
    // set of books, finhub_books/{book}, for Noisy Source, the household and
    // Noisy Phocus. These are Strata's own rules (every document held to its
    // shape), with these changes:
    //   - The root is finhub_books/{book} (Strata: users/{uid}). The path
    //     variable is still called userId, and so is the documents' field
    //     (Strata's names): both hold the book id, not a person's.
    //   - Only the one book exists (finhubBook()), and only its members write
    //     it (isFinhubUser(): Renato, verified; Marisa joins later).
    //   - Atlas (isAtlas(), Domotics block above) may READ the book, to answer
    //     money questions. Atlas writing (what it reads in documents) comes with
    //     its import tool, with its own limits, in a later change.
    // No AI and no server here: FinHub only reads and writes its book.
    // Tests: scripts/rules-tests/finhub-strata.rules-test.cjs.
    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // The one set of books (FINHUB_BOOK_ID in apps/noisysource/finhub/src/firebase.ts).
    function finhubBook() {
      return 'noisysource-group';
    }

    // Who keeps the books. Verified addresses only: anyone can create an
    // account with an address.
    function isFinhubUser() {
      return isSignedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['admin@noisysource.com'];
    }

    // Write access (Strata's name for it, kept so its rules read unchanged).
    function isOwner(userId) {
      return userId == finhubBook() && isFinhubUser();
    }

    // Read access: the book's keepers, and Atlas.
    // Claude Code (mcp/finhub), signed in as its own verified account.
    function isClaudeCode() {
      return isAuthenticated() &&
        request.auth.token.email == 'claude-code@kidclub.pt' &&
        request.auth.token.email_verified == true;
    }

    // The agents that read the book and propose changes to it (never write it).
    function finhubAgent() {
      return isAtlas() ? 'atlas' : isClaudeCode() ? 'claude-code' : '';
    }

    function isBookReader(userId) {
      return userId == finhubBook() && (isFinhubUser() || finhubAgent() != '');
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && id.size() <= 128 && (id == '' || id.matches('^[a-zA-Z0-9_\\-]+$'));
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidMonthStr(m) {
      return m is string && m.size() == 7 && m.matches('^\\d{4}-\\d{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function entityExists(userId, entityId) {
      return exists(/databases/$(database)/documents/finhub_books/$(userId)/entities/$(entityId)) ||
        existsAfter(/databases/$(database)/documents/finhub_books/$(userId)/entities/$(entityId));
    }

    function accountExists(userId, accountId) {
      return exists(/databases/$(database)/documents/finhub_books/$(userId)/accounts/$(accountId)) ||
        existsAfter(/databases/$(database)/documents/finhub_books/$(userId)/accounts/$(accountId));
    }

    function batchExists(userId, batchId) {
      return exists(/databases/$(database)/documents/finhub_books/$(userId)/statementBatches/$(batchId)) ||
        existsAfter(/databases/$(database)/documents/finhub_books/$(userId)/statementBatches/$(batchId));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    // An import as Atlas writes it (atlas_imports above): its envelope, held
    // to its keys, types and sizes; always pending, always Atlas's.
    function isValidAtlasImport(data) {
      return data.keys().hasOnly(['entityHint', 'month', 'summary', 'sources', 'statements', 'payslips',
          'contracts', 'subscriptions', 'facilities', 'setup', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['entityHint', 'month', 'summary', 'sources', 'statements', 'payslips',
          'contracts', 'subscriptions', 'facilities', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.status == 'pending' && data.createdBy == finhubAgent() &&
        data.entityHint is string && data.entityHint.size() <= 100 &&
        data.month is string && data.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$') &&
        data.summary is string && data.summary.size() <= 4000 &&
        data.sources is list && data.sources.size() <= 300 &&
        data.statements is list && data.statements.size() <= 20 &&
        data.payslips is list && data.payslips.size() <= 60 &&
        data.contracts is list && data.contracts.size() <= 20 &&
        data.subscriptions is list && data.subscriptions.size() <= 200 &&
        data.facilities is list && data.facilities.size() <= 20 &&
        // A proposed setup: entities, accounts (never account numbers) and loans.
        (!('setup' in data) || (data.setup is map &&
          data.setup.keys().hasOnly(['entities', 'accounts', 'loans']) &&
          (!('entities' in data.setup) || (data.setup.entities is list && data.setup.entities.size() <= 10)) &&
          (!('accounts' in data.setup) || (data.setup.accounts is list && data.setup.accounts.size() <= 20)) &&
          (!('loans' in data.setup) || (data.setup.loans is list && data.setup.loans.size() <= 20)))) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // What he committed from an import (utils/committed.ts): the items he kept, with his edits.
    function isValidCommitted(c) {
      return c is map &&
        c.keys().hasOnly(['contracts', 'subscriptions', 'facilities', 'payslips', 'statements']) &&
        c.contracts is list && c.contracts.size() <= 20 &&
        c.subscriptions is list && c.subscriptions.size() <= 200 &&
        c.facilities is list && c.facilities.size() <= 20 &&
        c.payslips is list && c.payslips.size() <= 60 &&
        c.statements is list && c.statements.size() <= 20;
    }

    function isValidWorkspaceProfile(data) {
      return data.keys().hasAll([
          'userId', 'currencyCode', 'currencySymbol', 'fiscalStartMonth',
          'onboardingComplete', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'currencyCode', 'currencySymbol', 'fiscalStartMonth',
          'onboardingComplete', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        data.currencyCode is string && data.currencyCode.size() == 3 &&
        data.currencyCode in ['USD', 'EUR', 'GBP', 'CAD', 'AUD', 'CHF', 'JPY', 'PLN', 'SEK', 'NOK'] &&
        data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 4 &&
        data.fiscalStartMonth is int && data.fiscalStartMonth >= 1 && data.fiscalStartMonth <= 12 &&
        data.onboardingComplete is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEntity(data) {
      return data.keys().hasAll([
          'userId', 'name', 'entityType', 'registrationCode', 'colorHex',
          'archived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'name', 'entityType', 'registrationCode', 'colorHex',
          'archived', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.entityType is string && data.entityType.size() <= 20 && data.entityType in ['personal', 'company'] &&
        data.registrationCode is string && data.registrationCode.size() <= 40 &&
        data.colorHex is string && data.colorHex.size() == 7 && data.colorHex.matches('^#[0-9a-fA-F]{6}$') &&
        data.archived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccount(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'name', 'institution', 'accountType',
          'balance', 'lastReconciledDate', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'name', 'institution', 'accountType', 'accountNumber',
          'balance', 'lastReconciledDate', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.institution is string && data.institution.size() >= 1 && data.institution.size() <= 80 &&
        data.accountType is string && data.accountType.size() <= 20 &&
        data.accountType in ['checking', 'savings', 'treasury', 'cash', 'meal_voucher', 'child_voucher'] &&
        (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() <= 34)) &&
        data.balance is number &&
        data.lastReconciledDate is string && data.lastReconciledDate.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCreditFacility(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'fundingAccountId', 'name', 'lender', 'facilityType',
          'principalOrLimit', 'currentBalance', 'apr', 'monthlyPayment', 'dueDay',
          'maturityDate', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'fundingAccountId', 'name', 'lender', 'facilityType',
          'principalOrLimit', 'currentBalance', 'apr', 'monthlyPayment', 'dueDay',
          'maturityDate', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidOptionalId(data.fundingAccountId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.lender is string && data.lender.size() >= 1 && data.lender.size() <= 80 &&
        data.facilityType is string && data.facilityType.size() <= 20 &&
        data.facilityType in ['term_loan', 'credit_line', 'credit_card', 'mortgage', 'equipment_loan'] &&
        data.principalOrLimit is number && data.principalOrLimit >= 0 &&
        data.currentBalance is number && data.currentBalance >= 0 &&
        data.apr is number && data.apr >= 0 && data.apr <= 100 &&
        data.monthlyPayment is number && data.monthlyPayment >= 0 &&
        data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31 &&
        data.maturityDate is string && data.maturityDate.size() <= 20 &&
        data.status is string && data.status.size() <= 16 && data.status in ['active', 'paid_off'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLedgerTransaction(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'accountId', 'facilityId', 'payslipId',
          'date', 'description', 'category', 'type', 'amount', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'accountId', 'facilityId', 'payslipId',
          'date', 'description', 'category', 'type', 'amount',
          'ivaRate', 'ivaAmount', 'ivaDeductible',
          'invoiceNumber', 'invoiceDocId', 'driveFileId', 'driveWebViewLink', 'driveFolderPath',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidId(data.accountId) &&
        isValidOptionalId(data.facilityId) &&
        isValidOptionalId(data.payslipId) &&
        isValidDateStr(data.date) &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.type is string && data.type.size() <= 20 &&
        data.type in ['income', 'expense', 'transfer', 'debt_payment', 'payroll'] &&
        data.amount is number && data.amount >= 0 &&
        (!('ivaRate' in data) || (data.ivaRate is number && data.ivaRate >= 0 && data.ivaRate <= 30)) &&
        (!('ivaAmount' in data) || (data.ivaAmount is number && data.ivaAmount >= 0)) &&
        (!('ivaDeductible' in data) || data.ivaDeductible is bool) &&
        (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 60)) &&
        (!('invoiceDocId' in data) || isValidOptionalId(data.invoiceDocId)) &&
        (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 160)) &&
        (!('driveWebViewLink' in data) || (data.driveWebViewLink is string && data.driveWebViewLink.size() <= 512)) &&
        (!('driveFolderPath' in data) || (data.driveFolderPath is string && data.driveFolderPath.size() <= 240)) &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['cleared', 'scheduled', 'reconciled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPayslipRecord(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'employeeName', 'periodStart', 'periodEnd',
          'payDate', 'taxDueDate', 'grossPay', 'netPay', 'employeeWithholdings',
          'employerTaxes', 'employerContributions', 'totalCost',
          'payStatus', 'taxStatus', 'sourceFilename', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'contractId', 'employeeName', 'periodStart', 'periodEnd',
          'payDate', 'taxDueDate', 'grossPay', 'netPay', 'employeeWithholdings',
          'employerTaxes', 'employerContributions', 'totalCost',
          'payStatus', 'taxStatus', 'sourceFilename', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        (!('contractId' in data) || isValidOptionalId(data.contractId)) &&
        data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100 &&
        isValidDateStr(data.periodStart) &&
        isValidDateStr(data.periodEnd) &&
        isValidDateStr(data.payDate) &&
        isValidDateStr(data.taxDueDate) &&
        data.grossPay is number && data.grossPay >= 0 &&
        data.netPay is number && data.netPay >= 0 &&
        data.employeeWithholdings is number && data.employeeWithholdings >= 0 &&
        data.employerTaxes is number && data.employerTaxes >= 0 &&
        data.employerContributions is number && data.employerContributions >= 0 &&
        data.totalCost is number && data.totalCost >= 0 &&
        data.payStatus is string && data.payStatus.size() <= 16 && data.payStatus in ['scheduled', 'paid'] &&
        data.taxStatus is string && data.taxStatus.size() <= 16 && data.taxStatus in ['scheduled', 'paid'] &&
        data.sourceFilename is string && data.sourceFilename.size() <= 140 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Client contracts (finhub/src/utils/clientContracts.ts): a pot of days at a daily rate.
    function isValidClientContract(data) {
      let keys = ['userId', 'entityId', 'clientName', 'reference', 'startDate', 'endDate',
        'daysAllowed', 'dailyRate', 'vatRate', 'paymentTermsDays', 'warnMonths', 'amendments',
        'active', 'notes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
        data.userId == finhubBook() && isValidId(data.entityId) &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
        data.reference is string && data.reference.size() <= 100 &&
        isValidDateStr(data.startDate) && isValidDateStr(data.endDate) && data.endDate >= data.startDate &&
        data.daysAllowed is number && data.daysAllowed > 0 && data.daysAllowed <= 2000 &&
        data.dailyRate is number && data.dailyRate > 0 && data.dailyRate <= 100000 &&
        data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 23 &&
        data.paymentTermsDays is number && data.paymentTermsDays >= 0 && data.paymentTermsDays <= 365 &&
        data.warnMonths is number && data.warnMonths >= 0 && data.warnMonths <= 24 &&
        data.amendments is list && data.amendments.size() <= 24 &&
        data.active is bool &&
        data.notes is string && data.notes.size() <= 1000;
    }

    function isValidContractHandover(data) {
      let keys = ['userId', 'contractId', 'month', 'days', 'dailyRate', 'amount', 'handedOverAt',
        'expectedPayDate', 'invoiceNumber', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
        data.userId == finhubBook() && isValidId(data.contractId) &&
        isValidMonthStr(data.month) &&
        data.days is number && data.days > 0 && data.days <= 31 &&
        data.dailyRate is number && data.dailyRate > 0 &&
        data.amount is number && data.amount >= 0 && data.amount <= 10000000 &&
        isValidDateStr(data.handedOverAt) && isValidDateStr(data.expectedPayDate) &&
        data.invoiceNumber is string && data.invoiceNumber.size() <= 60;
    }

    // A day he won't work: from his Google Calendar (Atlas keeps those in step) or entered here.
    function isValidDayOff(data) {
      let keys = ['userId', 'date', 'kind', 'label', 'source', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
        data.userId == finhubBook() && isValidDateStr(data.date) &&
        data.kind in ['vacation', 'day_off', 'client_closure', 'public_holiday'] &&
        data.label is string && data.label.size() <= 120 &&
        data.source in ['google', 'manual'];
    }

    function isValidForecastItem(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'name', 'direction', 'category',
          'monthlyAmount', 'startMonth', 'endMonth', 'annualGrowthRate',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'name', 'direction', 'category',
          'monthlyAmount', 'startMonth', 'endMonth', 'annualGrowthRate',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.direction is string && data.direction.size() <= 16 && data.direction in ['inflow', 'outflow'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.monthlyAmount is number && data.monthlyAmount >= 0 &&
        isValidMonthStr(data.startMonth) &&
        (data.endMonth is string && data.endMonth.size() <= 7 && (data.endMonth == '' || data.endMonth.matches('^\\d{4}-\\d{2}$'))) &&
        data.annualGrowthRate is number && data.annualGrowthRate >= -100 && data.annualGrowthRate <= 500 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStatementBatch(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'accountId', 'filename', 'statementPeriod',
          'openingBalance', 'closingBalance', 'lineCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'accountId', 'filename', 'statementPeriod',
          'openingBalance', 'closingBalance', 'lineCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidId(data.accountId) &&
        data.filename is string && data.filename.size() >= 1 && data.filename.size() <= 140 &&
        data.statementPeriod is string && data.statementPeriod.size() >= 1 && data.statementPeriod.size() <= 60 &&
        data.openingBalance is number &&
        data.closingBalance is number &&
        data.lineCount is int && data.lineCount >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStatementLine(data) {
      return data.keys().hasAll([
          'userId', 'batchId', 'entityId', 'accountId', 'date', 'description',
          'amount', 'direction', 'reconciliationStatus', 'matchedTransactionId',
          'discrepancyNote', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'batchId', 'entityId', 'accountId', 'date', 'description',
          'amount', 'direction', 'reconciliationStatus', 'matchedTransactionId',
          'discrepancyNote', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.batchId) &&
        isValidId(data.entityId) &&
        isValidId(data.accountId) &&
        isValidDateStr(data.date) &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
        data.amount is number && data.amount >= 0 &&
        data.direction is string && data.direction.size() <= 10 && data.direction in ['credit', 'debit'] &&
        data.reconciliationStatus is string && data.reconciliationStatus.size() <= 20 &&
        data.reconciliationStatus in ['unmatched', 'suggested', 'reconciled', 'discrepancy'] &&
        isValidOptionalId(data.matchedTransactionId) &&
        data.discrepancyNote is string && data.discrepancyNote.size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPersonalIncome(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'accountId', 'title', 'payerName',
          'incomeCategory', 'frequency', 'grossAmount', 'irsWithheldRate',
          'ssRate', 'countsTowardsIrs', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'accountId', 'title', 'payerName',
          'incomeCategory', 'frequency', 'grossAmount', 'irsWithheldRate',
          'ssRate', 'countsTowardsIrs', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidOptionalId(data.accountId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.payerName is string && data.payerName.size() >= 1 && data.payerName.size() <= 100 &&
        data.incomeCategory is string && data.incomeCategory.size() <= 30 &&
        data.incomeCategory in ['cat_a_dependent', 'cat_b_independent', 'cat_e_capital', 'cat_f_rental', 'other'] &&
        data.frequency is string && data.frequency.size() <= 20 &&
        data.frequency in ['monthly', '14_months', 'annual', 'one_off'] &&
        data.grossAmount is number && data.grossAmount >= 0 &&
        data.irsWithheldRate is number && data.irsWithheldRate >= 0 && data.irsWithheldRate <= 100 &&
        data.ssRate is number && data.ssRate >= 0 && data.ssRate <= 100 &&
        data.countsTowardsIrs is bool &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTaxSetting(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'region', 'isPme', 'ivaPeriodicity',
          'derramaRate', 'ircPaymentsOnAccount', 'irsMaritalStatus',
          'irsDependents', 'irsDeductions', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'region', 'isPme', 'ivaPeriodicity',
          'derramaRate', 'ircPaymentsOnAccount', 'irsMaritalStatus',
          'irsDependents', 'irsDeductions', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        data.region is string && data.region.size() <= 20 && data.region in ['continente', 'madeira', 'acores'] &&
        data.isPme is bool &&
        data.ivaPeriodicity is string && data.ivaPeriodicity.size() <= 20 && data.ivaPeriodicity in ['monthly', 'quarterly', 'exempt'] &&
        data.derramaRate is number && data.derramaRate >= 0 && data.derramaRate <= 5 &&
        data.ircPaymentsOnAccount is number && data.ircPaymentsOnAccount >= 0 &&
        data.irsMaritalStatus is string && data.irsMaritalStatus.size() <= 20 && data.irsMaritalStatus in ['single', 'married_joint'] &&
        data.irsDependents is int && data.irsDependents >= 0 && data.irsDependents <= 20 &&
        data.irsDeductions is number && data.irsDeductions >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEmploymentContract(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'fundingAccountId', 'workerName', 'roleTitle',
          'isOwnerIncome', 'personalEntityId', 'paySchedule', 'baseGrossMonthly',
          'irsRate', 'employeeSsRate', 'employerSsRate', 'mealAllowanceDaily',
          'mealPaymentMethod', 'childVoucherMonthly', 'childVoucherSubjectToIrs',
          'childVoucherSubjectToSs', 'otherBenefitName', 'otherBenefitMonthly',
          'otherBenefitSubjectToIrs', 'otherBenefitSubjectToSs', 'active',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'fundingAccountId', 'workerName', 'roleTitle',
          'isOwnerIncome', 'personalEntityId', 'paySchedule', 'baseGrossMonthly',
          'irsRate', 'employeeSsRate', 'employerSsRate', 'mealAllowanceDaily',
          'mealPaymentMethod', 'childVoucherMonthly', 'childVoucherSubjectToIrs',
          'childVoucherSubjectToSs', 'otherBenefitName', 'otherBenefitMonthly',
          'otherBenefitSubjectToIrs', 'otherBenefitSubjectToSs', 'active',
          'createdAt', 'updatedAt', 'versions'
        ]) &&
        // Terms over time (apps/noisysource/finhub/src/utils/contractVersions.ts): the app keeps
        // them sorted, one per month, the latest's terms on top; the rules bound their number.
        (!('versions' in data) || (data.versions is list && data.versions.size() <= 36)) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidOptionalId(data.fundingAccountId) &&
        data.workerName is string && data.workerName.size() >= 1 && data.workerName.size() <= 100 &&
        data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 80 &&
        data.isOwnerIncome is bool &&
        isValidOptionalId(data.personalEntityId) &&
        data.paySchedule is string && data.paySchedule.size() <= 20 && data.paySchedule in ['14_months', '12_months'] &&
        data.baseGrossMonthly is number && data.baseGrossMonthly >= 0 &&
        data.irsRate is number && data.irsRate >= 0 && data.irsRate <= 100 &&
        data.employeeSsRate is number && data.employeeSsRate >= 0 && data.employeeSsRate <= 100 &&
        data.employerSsRate is number && data.employerSsRate >= 0 && data.employerSsRate <= 100 &&
        data.mealAllowanceDaily is number && data.mealAllowanceDaily >= 0 &&
        data.mealPaymentMethod is string && data.mealPaymentMethod.size() <= 12 && data.mealPaymentMethod in ['card', 'cash', 'none'] &&
        data.childVoucherMonthly is number && data.childVoucherMonthly >= 0 &&
        data.childVoucherSubjectToIrs is bool &&
        data.childVoucherSubjectToSs is bool &&
        data.otherBenefitName is string && data.otherBenefitName.size() <= 60 &&
        data.otherBenefitMonthly is number && data.otherBenefitMonthly >= 0 &&
        data.otherBenefitSubjectToIrs is bool &&
        data.otherBenefitSubjectToSs is bool &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecurringExpense(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'paidByAccountId', 'paidByEntityId', 'creditFacilityId',
          'name', 'vendor', 'category', 'amount', 'frequency', 'billingDay', 'billingMonth',
          'ivaRate', 'ivaDeductible', 'hasInvoice', 'requiresReimbursement', 'lastPostedDate',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'paidByAccountId', 'paidByEntityId', 'creditFacilityId',
          'name', 'vendor', 'category', 'amount', 'frequency', 'billingDay', 'billingMonth',
          'ivaRate', 'ivaDeductible', 'hasInvoice', 'requiresReimbursement', 'lastPostedDate',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidId(data.paidByAccountId) &&
        isValidId(data.paidByEntityId) &&
        isValidOptionalId(data.creditFacilityId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.vendor is string && data.vendor.size() >= 1 && data.vendor.size() <= 80 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.amount is number && data.amount >= 0 &&
        data.frequency is string && data.frequency.size() <= 16 && data.frequency in ['monthly', 'annual'] &&
        data.billingDay is int && data.billingDay >= 1 && data.billingDay <= 31 &&
        data.billingMonth is int && data.billingMonth >= 1 && data.billingMonth <= 12 &&
        data.ivaRate is number && data.ivaRate >= 0 && data.ivaRate <= 30 &&
        data.ivaDeductible is bool &&
        data.hasInvoice is bool &&
        data.requiresReimbursement is bool &&
        data.lastPostedDate is string && data.lastPostedDate.size() <= 20 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExpenseReimbursement(data) {
      return data.keys().hasAll([
          'userId', 'owedByEntityId', 'owedToEntityId', 'paidByAccountId',
          'recurringExpenseId', 'transactionId', 'date', 'vendor', 'description',
          'invoiceNumber', 'hasInvoice', 'amount', 'ivaRate', 'ivaAmount',
          'ivaDeductible', 'status', 'settledDate', 'settledFromAccountId',
          'settledToAccountId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'owedByEntityId', 'owedToEntityId', 'paidByAccountId',
          'recurringExpenseId', 'transactionId', 'date', 'vendor', 'description',
          'invoiceNumber', 'hasInvoice', 'amount', 'ivaRate', 'ivaAmount',
          'ivaDeductible', 'driveFileId', 'driveWebViewLink', 'driveFolderPath',
          'status', 'settledDate', 'settledFromAccountId',
          'settledToAccountId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.owedByEntityId) &&
        isValidId(data.owedToEntityId) &&
        data.owedByEntityId != data.owedToEntityId &&
        isValidOptionalId(data.paidByAccountId) &&
        isValidOptionalId(data.recurringExpenseId) &&
        isValidOptionalId(data.transactionId) &&
        isValidDateStr(data.date) &&
        data.vendor is string && data.vendor.size() >= 1 && data.vendor.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 160 &&
        data.invoiceNumber is string && data.invoiceNumber.size() <= 60 &&
        data.hasInvoice is bool &&
        data.amount is number && data.amount >= 0 &&
        data.ivaRate is number && data.ivaRate >= 0 && data.ivaRate <= 30 &&
        data.ivaAmount is number && data.ivaAmount >= 0 &&
        data.ivaDeductible is bool &&
        (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 160)) &&
        (!('driveWebViewLink' in data) || (data.driveWebViewLink is string && data.driveWebViewLink.size() <= 512)) &&
        (!('driveFolderPath' in data) || (data.driveFolderPath is string && data.driveFolderPath.size() <= 240)) &&
        data.status is string && data.status.size() <= 16 && data.status in ['open', 'settled'] &&
        data.settledDate is string && data.settledDate.size() <= 20 &&
        isValidOptionalId(data.settledFromAccountId) &&
        isValidOptionalId(data.settledToAccountId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvoiceDocument(data) {
      return data.keys().hasAll([
          'userId', 'entityId', 'accountId', 'transactionId', 'statementLineId',
          'reimbursementId', 'source', 'vendor', 'vendorNif', 'invoiceNumber',
          'date', 'amount', 'ivaRate', 'ivaAmount', 'ivaDeductible', 'filename',
          'driveFileId', 'driveWebViewLink', 'driveFolderId', 'driveFolderPath',
          'gmailMessageId', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'entityId', 'accountId', 'transactionId', 'statementLineId',
          'reimbursementId', 'source', 'vendor', 'vendorNif', 'invoiceNumber',
          'date', 'amount', 'ivaRate', 'ivaAmount', 'ivaDeductible', 'filename',
          'driveFileId', 'driveWebViewLink', 'driveFolderId', 'driveFolderPath',
          'gmailMessageId', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == finhubBook() &&
        isValidId(data.entityId) &&
        isValidOptionalId(data.accountId) &&
        isValidOptionalId(data.transactionId) &&
        isValidOptionalId(data.statementLineId) &&
        isValidOptionalId(data.reimbursementId) &&
        data.source is string && data.source.size() <= 16 && data.source in ['gmail', 'drive', 'upload'] &&
        data.vendor is string && data.vendor.size() >= 1 && data.vendor.size() <= 80 &&
        data.vendorNif is string && data.vendorNif.size() <= 40 &&
        data.invoiceNumber is string && data.invoiceNumber.size() <= 60 &&
        isValidDateStr(data.date) &&
        data.amount is number && data.amount >= 0 &&
        data.ivaRate is number && data.ivaRate >= 0 && data.ivaRate <= 30 &&
        data.ivaAmount is number && data.ivaAmount >= 0 &&
        data.ivaDeductible is bool &&
        data.filename is string && data.filename.size() >= 1 && data.filename.size() <= 140 &&
        data.driveFileId is string && data.driveFileId.size() <= 160 &&
        data.driveWebViewLink is string && data.driveWebViewLink.size() <= 512 &&
        data.driveFolderId is string && data.driveFolderId.size() <= 160 &&
        data.driveFolderPath is string && data.driveFolderPath.size() <= 240 &&
        data.gmailMessageId is string && data.gmailMessageId.size() <= 160 &&
        data.status is string && data.status.size() <= 20 && data.status in ['inbox', 'filed', 'reconciled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Rules
    // -------------------------------------------------------------------------
    match /finhub_books/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isBookReader(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidWorkspaceProfile(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidWorkspaceProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'currencyCode', 'currencySymbol', 'fiscalStartMonth', 'onboardingComplete', 'updatedAt'
        ]);
      allow delete: if false;

      // What Atlas read from the documents (payslips, statements, and the
      // contracts, subscriptions and loans it found in them), one import per
      // entity and month, waiting for Renato (apps/noisysource/finhub/STATUS.md).
      // Atlas writes only here, and only while an import is pending; FinHub
      // opens one in its review workbench, and the books change only when he
      // commits it there, as if he had read the files himself. The drafts'
      // inner fields are re-checked and coerced by the app when it opens one.
      match /atlas_imports/{importId} {
        allow get, list: if isSignedIn() && isBookReader(userId);
        // An agent proposes (Atlas or Claude Code, each as itself); only he decides, in FinHub.
        allow create: if finhubAgent() != '' && userId == finhubBook() && isValidId(importId) &&
          isValidAtlasImport(incoming()) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if (finhubAgent() != '' && userId == finhubBook() &&
            existing().status == 'pending' && existing().createdBy == finhubAgent() &&
            isValidAtlasImport(incoming()) && incoming().updatedAt == request.time) ||
          (isOwner(userId) && existing().status == 'pending' &&
            incoming().status in ['applied', 'dismissed'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'decidedAt', 'committed']) &&
            incoming().decidedAt == request.time &&
            // What he committed (only on commit), for Atlas to learn from his corrections.
            (!('committed' in incoming()) || (incoming().status == 'applied' && isValidCommitted(incoming().committed))));
        allow delete: if isOwner(userId);
      }

      match /entities/{entityId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(entityId) && isBookReader(userId);
        allow list: if isSignedIn() && isBookReader(userId) && resource.data.userId == finhubBook();
        allow create: if isVerified() && isValidId(userId) && isValidId(entityId) && isOwner(userId) &&
          isValidEntity(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(entityId) && isOwner(userId) &&
          isValidEntity(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'entityType', 'registrationCode', 'colorHex', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(entityId) && isOwner(userId);
      }

      match /accounts/{accountId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(accountId) && isBookReader(userId);
        allow list: if isSignedIn() && isBookReader(userId) && resource.data.userId == finhubBook();
        allow create: if isVerified() && isValidId(userId) && isValidId(accountId) && isOwner(userId) &&
          isValidAccount(incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          entityExists(userId, incoming().entityId);
        allow update: if isVerified() && isValidId(userId) && isValidId(accountId) && isOwner(userId) &&
          isValidAccount(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'institution', 'accountType', 'accountNumber', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['lastReconciledDate', 'balance', 'updatedAt'])
          );
        allow delete: if isVerified() && isValidId(userId) && isValidId(accountId) && isOwner(userId);
      }

