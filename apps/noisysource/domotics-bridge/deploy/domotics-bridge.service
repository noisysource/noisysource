[Unit]
Description=NoisySource domotics bridge (Tuya over LAN)
Documentation=https://github.com/noisysource/noisysource
After=network-online.target
Wants=network-online.target

# Give up trying only if it fails constantly for five minutes — otherwise
# systemd's default burst limit would stop restarting during a router reboot.
# These belong in [Unit]: systemd ignores them under [Service].
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/domotics-bridge

# The repeater's proxy-ARP does not answer for every device, and the ones it
# ignores stay in NUD FAILED indefinitely. `+` runs this as root despite
# User=pi; `-` means a failure here never stops the bridge starting.
ExecStartPre=+-/home/pi/domotics-bridge/deploy/pin-device-arp.sh

# /usr/local, not /usr/bin: on ARMv6 Node comes from the unofficial builds
# tarball unpacked into /usr/local, since neither NodeSource nor nodejs.org
# publish for this architecture.
ExecStart=/usr/local/bin/node lib/index.js

# The bridge deliberately exits when every device fails several polls running,
# because a wedged process reporting a house full of sleeping thermostats is
# worse than one that stops. That design only works with a supervisor, so this
# must always restart.
Restart=always
RestartSec=10

# Firebase Auth user credentials, not a service-account key: key creation is
# refused by the org policy iam.disableServiceAccountKeyCreation, and signing in
# as a user means firestore.rules — not IAM — decides what this machine can
# reach. Contains a password, so the file is 0600 and gitignored.
#
# Leading `-`: optional. Without it a missing file fails the unit outright, and
# the bridge crash-loops into its start limit — which is precisely backwards.
# The devices are on the LAN and controllable without Google's involvement, so
# no credentials should cost the relay and nothing else.
EnvironmentFile=-/home/pi/domotics-bridge/bridge.env
Environment=GCLOUD_PROJECT=kidclub-dev
Environment=NODE_ENV=production

# 512MB of swap on an SD card is slower than useless under real pressure, and
# this board has 173MB of RAM. Fail loudly instead of thrashing the card.
MemoryMax=140M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=domotics-bridge

[Install]
WantedBy=multi-user.target
